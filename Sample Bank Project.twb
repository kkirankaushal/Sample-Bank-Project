      <column caption='Dynamic Metric' datatype='real' name='[Calculation_1807069412108029952]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 2] = &quot;Transaction Count&quot; THEN&#13;&#10;    SUM([Transaction Count])&#13;&#10;ELSE&#13;&#10;    SUM([Transaction Count]) / TOTAL(SUM([Transaction Count]))&#13;&#10;END'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Top Merchant Filter' datatype='boolean' name='[Calculation_1807069412112945156]' role='measure' type='nominal'>
        <calculation class='tableau' formula='RANK(SUM([Transaction Count])) &lt;= [Parameters].[Parameter 1]'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Top 20 Merchants' datatype='boolean' name='[Calculation_1807069412115234821]' role='measure' type='nominal'>
        <calculation class='tableau' formula='RANK(SUM([Transaction Count])) &lt;= 15'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='% Transaction Source' datatype='real' name='[Dynamic Metric (copy)_1807069412109803521]' role='measure' type='ordinal'>
        <calculation class='tableau' formula='SUM([Transaction Count]) / TOTAL(SUM([Transaction Count]))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
